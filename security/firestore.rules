rules_version = '2';
// 白沙屯醫護團 Firestore 安全規則（倉庫、救護紀錄表、會員中心共用）
// 登入方式：LINE → Cloudflare Worker 驗證 → Firebase 自訂權杖，request.auth.uid = LINE userId
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function userPath(id) { return /databases/$(database)/documents/users/$(id); }
    function rosterPath(id) { return /databases/$(database)/documents/member_roster/$(id); }
    function myData() { return get(userPath(me())).data; }
    function approved() { return signedIn() && exists(userPath(me())) && myData().get('status', '') == 'approved'; }
    // 管理員權限分三個系統：role == 'admin' 表示三個都是；否則看 adminMember / adminWarehouse / adminRecord
    function isSuper() { return approved() && myData().get('role', '') == 'admin'; }
    function isAdmin() { return isSuper() || (approved() && myData().get('adminMember', false) == true); }      // 會員中心
    function inWarehouse() { return approved() && myData().get('warehouseRemoved', false) != true; }
    function whAdmin() { return inWarehouse() && (myData().get('role', '') == 'admin' || myData().get('adminWarehouse', false) == true); }
    function recAdmin() { return isSuper() || (approved() && myData().get('adminRecord', false) == true); }
    function anyAdmin() { return isAdmin() || whAdmin() || recAdmin(); }
    function cleanName(s) { return s.replace(' ', '').replace('　', ''); }

    // 本人用「姓名＋身分證＋生日」對上管理員匯入的名冊，才可自動開通
    function rosterMatches(d) {
      let r = get(rosterPath(d.rosterId)).data;
      return d.get('verifiedBy', '') == 'roster'
        && r.get('createdBySelf', false) != true
        && r.get('idCard', '') == d.get('idCard', '')
        && r.get('birthday', '') == d.get('birthday', '')
        && r.get('name', '') == cleanName(d.get('realName', ''))
        && r.get('boundUserId', null) in [null, '', me()];
    }

    // 本人不能自己改的欄位（權限、審核、移出倉庫）
    function lockedKeys() {
      return ['role', 'adminMember', 'adminWarehouse', 'adminRecord', 'status', 'verifiedBy', 'rosterId', 'approvedAt', 'approvedBy', 'rejectReason',
              'warehouseRemoved', 'warehouseRemovedBy', 'warehouseRemovedAt', 'lineUserId'];
    }

    function selfUpdateOk() {
      let d = request.resource.data;
      let o = resource.data;
      let changed = d.diff(o).affectedKeys();
      let hard = ['role', 'adminMember', 'adminWarehouse', 'adminRecord', 'approvedBy', 'warehouseRemoved', 'warehouseRemovedBy', 'warehouseRemovedAt', 'lineUserId'];
      return
        // 一般更新：頭貼、登入時間、姓名、證照…
        !changed.hasAny(lockedKeys())
        // 重新送審 → 待審核
        || (o.get('status', '') != 'banned' && d.get('status', '') == 'pending'
            && !changed.hasAny(hard.concat(['verifiedBy', 'approvedAt', 'rosterId'])))
        // 重新送審且對上名冊 → 自動開通
        || (o.get('status', '') != 'banned' && d.get('status', '') == 'approved'
            && !changed.hasAny(hard) && rosterMatches(d))
        // 會員中心「編輯我的資料」：連到自己綁定的名冊
        || (changed.intersection(lockedKeys().toSet()) == ['rosterId'].toSet()
            && get(rosterPath(d.rosterId)).data.get('boundUserId', '') == me());
    }

    function selfCreateOk() {
      let d = request.resource.data;
      return d.get('role', 'user') == 'user'
        && !d.keys().hasAny(['approvedBy', 'warehouseRemoved', 'adminMember', 'adminWarehouse', 'adminRecord'])
        && (d.get('status', 'pending') == 'pending' || (d.get('status', '') == 'approved' && rosterMatches(d)));
    }

    // ===== 會員帳號（三個系統共用）=====
    match /users/{userId} {
      allow get: if signedIn() && (me() == userId || anyAdmin());
      allow list: if anyAdmin();
      allow create: if isAdmin() || (signedIn() && me() == userId && selfCreateOk());
      allow update: if isAdmin() || (signedIn() && me() == userId && selfUpdateOk());
      allow delete: if isAdmin();
    }

    // ===== 團員名冊 =====
    // 文件 ID = SHA-256(身分證|生日)，知道本人資料才算得出來，所以允許單筆讀取做註冊比對
    match /member_roster/{rid} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.get('createdBySelf', false) == true
            && request.resource.data.get('boundUserId', '') == me());
      allow update: if isAdmin()
        // 本人編輯自己的團員資料（序號、加入年份、備註只能管理員改）
        || (signedIn() && resource.data.get('boundUserId', '') == me()
            && request.resource.data.get('boundUserId', '') == me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'name', 'nameRaw', 'idCard', 'idCardRaw', 'birthday', 'birthdayRaw',
                 'lineName', 'phone', 'emName', 'emRelation', 'emPhone', 'shirtSize', 'pantsSize',
                 'certText', 'cert', 'address', 'job', 'introducer', 'education',
                 'updatedAt', 'updatedBy', 'updatedByRole', 'editLog', 'confirmedAt']))
        // 自動開通後綁定：名冊尚未被綁定，且本人帳號已指向這筆名冊
        || (signedIn() && resource.data.get('boundUserId', null) in [null, '']
            && request.resource.data.boundUserId == me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boundUserId', 'boundAt'])
            && get(userPath(me())).data.get('rosterId', '') == rid);
      allow delete: if isAdmin();
    }

    // ===== 新人入團申請表（公開表單，不用登入就能送出；只有管理員能看） =====
    function shortStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    match /roster_applications/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'lineName', 'birthday', 'birthdayRaw', 'idCard', 'phone',
            'emName', 'emRelation', 'emPhone', 'shirtSize', 'pantsSize', 'certText', 'address', 'job', 'introducer', 'education',
            'notes', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.idCard is string && request.resource.data.idCard.matches('^[A-Z][1289][0-9]{8}$')
        && shortStr(request.resource.data, 'lineName', 40) && shortStr(request.resource.data, 'phone', 20)
        && shortStr(request.resource.data, 'emName', 20) && shortStr(request.resource.data, 'emRelation', 10)
        && shortStr(request.resource.data, 'emPhone', 20) && shortStr(request.resource.data, 'certText', 120)
        && shortStr(request.resource.data, 'address', 120) && shortStr(request.resource.data, 'job', 40)
        && shortStr(request.resource.data, 'introducer', 20) && shortStr(request.resource.data, 'education', 300)
        && shortStr(request.resource.data, 'notes', 300) && shortStr(request.resource.data, 'shirtSize', 5)
        && shortStr(request.resource.data, 'pantsSize', 5) && shortStr(request.resource.data, 'birthday', 10)
        && shortStr(request.resource.data, 'birthdayRaw', 10);
      allow read, update, delete: if isAdmin();
    }

    // ===== 出席調查：公開表單，不用登入就能回覆；只有管理員看得到回覆 =====
    match /events/{eid} {
      allow get: if true;
      allow list: if signedIn();
      allow write: if isAdmin();
      match /responses/{rid} {
        allow create: if get(/databases/$(database)/documents/events/$(eid)).data.get('open', false) == true
          && request.resource.data.keys().hasOnly(['name', 'lineName', 'attend', 'lunch', 'reason', 'comment', 'createdAt', 'src'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
          && request.resource.data.attend in ['yes', 'join', 'no']
          && request.resource.data.createdAt == request.time
          && shortStr(request.resource.data, 'lineName', 40) && shortStr(request.resource.data, 'lunch', 10)
          && shortStr(request.resource.data, 'reason', 300) && shortStr(request.resource.data, 'comment', 500)
          && shortStr(request.resource.data, 'src', 10);
        allow read, update, delete: if isAdmin();
      }
      // 只有管理員看得到的資料（分組抽籤結果）
      match /admin/{doc} {
        allow read, write: if isAdmin();
      }
    }

    // ===== 救護紀錄表 =====
    match /medical_records/{id} {
      allow create: if approved();
      allow read, update, delete: if recAdmin();
    }
    match /system_configs/{id} {
      allow read: if signedIn();
      allow write: if recAdmin();
    }

    // ===== 倉庫 =====
    match /warehouse_boxes/{id} { allow read: if inWarehouse(); allow write: if whAdmin(); }
    match /warehouse_pages/{id} { allow read: if inWarehouse(); allow write: if whAdmin(); }
    match /warehouse_logs/{id}  { allow read: if inWarehouse(); allow write: if whAdmin(); }
    match /settings/{id}        { allow read: if inWarehouse(); allow write: if whAdmin(); }

    // 其他沒列出的集合一律拒絕
  }
}
